# ==============================================================================
# Shikshak AI — environment configuration
# Copy to .env and fill in:  cp .env.example .env
# ==============================================================================

# ---- Application ----
APP_NAME=Shikshak AI
API_V1_STR=/api/v1
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
# Used in emails to link back to the app. Set to your real domain in production.
PUBLIC_BASE_URL=http://localhost:8000

# ---- Security ----
# REQUIRED IN PRODUCTION. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# If unset, a key is generated once and stored in data/.secret_key. Changing it
# signs every user out.
SECRET_KEY=

ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15

# ---- Database ----
# SQLite, relative to the project root.
DATABASE_URL=sqlite:///data/shikshak.db
SQL_ECHO=false

# ---- Email / OTP ----
# Signup verification and password reset both send a one-time code.
#
# RESEND_API_KEY (recommended for hosts like Render, Railway, Heroku): most
# PaaS hosts block outbound SMTP entirely, so raw SMTP to smtp.gmail.com fails
# with "Network is unreachable" no matter how correct the credentials are.
# Resend sends over plain HTTPS instead, which those hosts do allow. Get a key
# at https://resend.com — free tier is enough for OTP volume. When this is
# set it is tried first; SMTP below still works as a fallback/local option.
RESEND_API_KEY=

# SMTP fallback — works fine for local development and any host that allows
# outbound SMTP. For Gmail: enable 2-Step Verification, then create an App
# Password at https://myaccount.google.com/apppasswords and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Shikshak AI

# With SMTP unconfigured, codes are written to data/outbox/ and returned in the
# API response as "dev_otp" so local demos still work. NEVER leave this on in
# production — it exposes verification codes to the caller.
EMAIL_DEV_FALLBACK=true

OTP_LENGTH=6
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60

# ---- LLM ----
# Google AI Studio: https://aistudio.google.com/
# Without a key the system falls back to a deterministic offline adapter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Storage ----
CHROMA_PERSIST_DIR=chroma_db
UPLOAD_ROOT=data/storage
MEDIA_ROOT=data/media
MAX_UPLOAD_MB=25

# NOTE: everything above lives on the local filesystem. On a host with an
# ephemeral filesystem (Render free tier, most container PaaS) a deploy or
# restart wipes the database, uploads, rendered videos and the vector index —
# accounts included. Mount a persistent disk at data/ before real users.
# Only sqlite:/// URLs are supported; DATABASE_URL cannot point at Postgres.

# ---- Retrieval models (memory sensitive) ----
# Loaded lazily on the FIRST document upload, not at startup, so a too-small
# instance survives boot and is then OOM-killed by the first learner who
# uploads a file. Measured resident memory with the defaults:
#   BAAI/bge-m3              ~2.4 GB
#   BAAI/bge-reranker-v2-m3  ~1.3 GB on top   (~3.8 GB peak total)
# Leave unset for best quality on a machine with >= 4 GB. On a small instance
# choose a MiniLM-sized model and turn the cross-encoder off — retrieval then
# falls back to the built-in lexical-overlap reranking.
#   EMBEDDING_BACKEND=e5
#   EMBEDDING_MODEL=intfloat/multilingual-e5-small
#   RERANKER_ENABLED=false
EMBEDDING_BACKEND=bge-m3
EMBEDDING_MODEL=
EMBEDDING_DEVICE=cpu
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- Retrieval behaviour ----
# Bounded agentic loop: refines a weakly-grounded first pass once, then falls
# back to the single-pass result. false restores exact single-pass retrieval.
AGENTIC_RAG_ENABLED=true
AGENTIC_RAG_MAX_REFINEMENTS=1

# ---- Avatar (optional Tier 2 neural model) ----
MUSETALK_CHECKPOINT_DIR=models/musetalk

# ---- CORS ----
# Comma-separated origins. Leave blank for the localhost defaults.
CORS_ORIGINS=

# ---- Proxy ----
# Set to true ONLY when a reverse proxy in front of this app sets
# X-Forwarded-For. With it on and no such proxy, any client can forge an address
# per request and walk straight through the rate limits.
TRUST_PROXY_HEADERS=false
